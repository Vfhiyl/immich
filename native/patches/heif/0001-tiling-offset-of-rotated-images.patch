From ac83c6db7d32ed501630bde4478b3ab30d6df589 Mon Sep 17 00:00:00 2001
From: Vfhiyl <VfhiyL@proton.me>
Date: Tue, 27 Oct 2026 02:04:26 +0800
Subject: [PATCH] Give the tiling of a rotated or mirrored image the offset of
 its tiles

heif_image_handle_get_image_tiling() with process_image_transformations gives where the first tile of a rotated or mirrored image is (left_offset, top_offset: how far it reaches beyond the image), from the part of the last column or row of tiles that is beyond the image before the transformation. It took the part inside the image (image_width % tile_width) instead: a photo of 3000x4000 in tiles of 512, rotated, was said to begin 440 pixels to the left of the image, while its first tile begins 72 pixels to the left (3072 - 3000), as decoding the tiles shows.

libvips decodes such photos a row of tiles at a time (patches/libvips/0005), and places the tiles by these offsets. Not fixed in libheif 1.23.7 or master (2026-10-27).
---
 libheif/image-items/image_item.cc | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/libheif/image-items/image_item.cc b/libheif/image-items/image_item.cc
index f468e9c..6d7c483 100644
--- a/libheif/image-items/image_item.cc
+++ b/libheif/image-items/image_item.cc
@@ -1833,9 +1833,10 @@ Error ImageItem::process_image_transformations_on_tiling(heif_image_tiling& tili
 
   // Prevent divide by zero.
 
+  // the part of the last column (row) of tiles beyond the image
   if (tiling.tile_width != 0 && tiling.tile_height != 0) {
-    right_excess = tiling.image_width % tiling.tile_width;
-    bottom_excess = tiling.image_height % tiling.tile_height;
+    right_excess = (tiling.tile_width - tiling.image_width % tiling.tile_width) % tiling.tile_width;
+    bottom_excess = (tiling.tile_height - tiling.image_height % tiling.tile_height) % tiling.tile_height;
   }
   else {
     right_excess = 0;
