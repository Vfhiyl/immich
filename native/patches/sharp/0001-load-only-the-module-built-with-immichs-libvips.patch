-    );
-  }
-  help.push("- Consult the installation documentation:", "    See https://sharp.pixelplumbing.com/install");
-  throw new Error(help.join("\n"));
+  throw new Error(
+    `Could not load sharp-${runtimePlatform}-${version}.node, built with Immich's libvips: ${err.message}\n` +
+      "Install it with server/bin/install-native (see native/README.md in Immich's repository).",
+    { cause: err },
+  );
