+// server/bin/install-native installs here; never a prebuilt module or a libvips installed on the machine
 try {
   sharp = require(`../src/build/Release/sharp-${runtimePlatform}-${version}.node`);
 } catch (err) {
-  errors.push(err);
-}
-if (!sharp) {
-  try {
